{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!dist",
      "!site/.next",
      "!site/out",
      "!site/next-env.d.ts",
      "!site/public/r"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "rules": {
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": { "inputComponents": ["Checkbox", "Radio", "Switch"] }
        }
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
