{
  "name": "@roprgm/ui",
  "version": "0.8.2",
  "description": "A minimal, dark UI library for React.",
  "homepage": "https://ui.roprgm.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roprgm/ui.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./base.css": "./src/base.css",
    "./themes/default.css": "./src/themes/default.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "dev": "next dev site",
    "check": "biome check --write && tsc",
    "build": "bun scripts/registry.ts && biome format --write registry.json && tsc -p tsconfig.build.json && shadcn build -o site/public/r && next build site",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.8",
    "@stefanprobst/rehype-extract-toc": "^3.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.5",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-slug": "^6.0.0",
    "shadcn": "^4.21.0",
    "sugar-high": "^2.4.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
