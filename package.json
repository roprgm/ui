{
  "name": "@roprgm/ui",
  "version": "0.7.1",
  "description": "A minimal, dark UI library for React.",
  "homepage": "https://ui.roprgm.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roprgm/ui.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./base.css": "./src/base.css",
    "./themes/default.css": "./src/themes/default.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./src/components/tailwind.css"
  },
  "scripts": {
    "dev": "bun scripts/tailwind.ts && vite",
    "check": "bun scripts/tailwind.ts && biome check --write && tsc",
    "build": "bun scripts/tailwind.ts && bun scripts/styles.ts && bun scripts/registry.ts && biome format --write registry.json src/components/tailwind.css && tsc -p tsconfig.build.json && shadcn build -o site/public/r && vite build",
    "prepublishOnly": "bun run build",
    "verify": "bun scripts/verify.ts"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "cn": "^0.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "postcss": "8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "sugar-high": "^2.4.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
