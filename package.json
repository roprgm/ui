{
  "name": "@roprgm/ui",
  "version": "0.5.1",
  "description": "A minimal, dark UI library for React.",
  "homepage": "https://ui.roprgm.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roprgm/ui.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./theme.css": "./src/theme.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "check": "biome check --write && tsc",
    "build": "bun scripts/registry.ts && biome format --write registry.json && tsc -p tsconfig.build.json && shadcn build -o site/public/r && vite build",
    "snapshots": "playwright test",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@fontsource-variable/geist": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "sugar-high": "^2.4.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
