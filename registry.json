{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "roprgm",
  "homepage": "https://ui.roprgm.com",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "css": {
        ":root": {
          "--font-sans": "\"Geist Variable\", \"Geist\", system-ui, sans-serif",
          "--text-shadow-default": "0.5px 1px 0.5px oklch(19.1% 0 0 / 0.2)",
          "--text-shadow-subtle": "0.5px 1px 0.5px oklch(0% 0 0 / 0.08)",
          "--edge-raised": "inset 0 1px 0 oklch(95% 0 0 / 0.08), 0 1px 1px oklch(0% 0 0 / 0.28),\n    0 0 1px oklch(0% 0 0 / 0.14)",
          "--edge-card": "inset 0 1px 0 oklch(95% 0 0 / 0.08), 0 1px 1px oklch(0% 0 0 / 0.28),\n    0 0 1px oklch(0% 0 0 / 0.14)",
          "--edge-sunken": "inset 0 1px 1px oklch(0% 0 0 / 0.3), 0 1px 0 oklch(95% 0 0 / 0.08)",
          "--edge-float": "0 0 0px 1px oklch(10% 0 0 / 0.25), inset 0 1px 0 oklch(100% 0 0 / 0.08),\n    0 2px 6px oklch(0% 0 0 / 0.3), 0 4px 16px 0 oklch(10% 0 0 / 0.1)",
          "--edge-primary": "0 0 2px 1px oklch(10% 0 0 / 0.3), inset 0 1px 0 oklch(95% 0 0 / 0.2),\n    0 1px 2px oklch(10% 0 0 / 0.5)",
          "--edge-separator": "0 1px 0 oklch(95.5% 0 0 / 0.05)",
          "--edge-separator-vertical": "1px 0 0 oklch(95.5% 0 0 / 0.05)"
        },
        "@layer base": {
          "body": {
            "font-family": "var(--font-sans)",
            "font-size": "13px",
            "line-height": "20px",
            "color": "var(--color-foreground)",
            "background": "var(--color-surface)",
            "color-scheme": "dark",
            "text-shadow": "var(--text-shadow-default)"
          },
          "button,\n  input,\n  textarea": {
            "text-shadow": "inherit"
          },
          "label:has(input:is([type=\"checkbox\"], [type=\"radio\"]):enabled)": {
            "cursor": "pointer"
          }
        }
      },
      "registryDependencies": ["https://ui.roprgm.com/r/core.json"],
      "docs": "Components include their own styles. To use the library tokens and helpers in your app’s Tailwind classes, add @reference to the installed ui/core.css from your main CSS file (the relative path depends on your components.json aliases)."
    },
