{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "roprgm",
  "homepage": "https://ui.roprgm.com",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "cssVars": {
        "theme": {
          "font-sans": "\"Geist Variable\", \"Geist\", system-ui, sans-serif",
          "color-hover": "hsl(0 0% 100% / 0.08)",
          "color-pressed": "hsl(0 0% 100% / 0.15)",
          "color-foreground": "hsl(0 0% 95%)",
          "color-muted": "hsl(0 0% 63%)",
          "color-faint": "hsl(0 0% 45%)",
          "color-disabled": "hsl(0 0% 32%)",
          "color-primary": "hsl(0 0% 86%)",
          "color-primary-hover": "hsl(0 0% 98%)",
          "color-on-primary": "hsl(0 0% 9%)",
          "color-line": "hsl(0 0% 0% / 0.4)",
          "color-backdrop": "hsl(0 0% 0% / 0.5)",
          "color-focus": "hsl(0 0% 100% / 0.25)",
          "color-danger": "hsl(0 90% 75%)",
          "color-surface-1": "hsl(0 0% 4.0%)",
          "color-surface-2": "hsl(0 0% 8.0%)",
          "color-surface-3": "hsl(0 0% 12.3%)",
          "color-surface-4": "hsl(0 0% 17.0%)",
          "color-surface-5": "hsl(0 0% 22.0%)",
          "color-surface-6": "hsl(0 0% 27.3%)",
          "color-surface-7": "hsl(0 0% 33.0%)",
          "color-surface-8": "hsl(0 0% 39.0%)",
          "color-tooltip": "var(--color-surface-1)",
          "radius-xs": "2.5px",
          "radius-sm": "4.5px",
          "radius-md": "7px",
          "radius-lg": "9px",
          "radius-xl": "12px",
          "radius-2xl": "16px",
          "size-control": "2rem",
          "size-control-sm": "1.75rem",
          "size-control-xs": "1.5rem",
          "size-row": "2.5rem",
          "shadow-raised": "inset 0 1px 0 rgba(240, 240, 240, 0.07), 0 1px 1px rgb(0 0 0 / 0.28), 0 0 1px rgb(0 0 0 / 0.14)",
          "shadow-sunken": "inset 0 1px 1px rgb(0 0 0 / 0.3), 0 1px 0 rgb(240 240 240 / 0.05)",
          "shadow-divider": "0 1px 0 rgb(240 240 240 / 0.05)",
          "shadow-float": "0 0 0 1px hsl(0 0% 9%), inset 0 1px 0 rgb(255 255 255 / 0.08), 0 2px 6px rgb(0 0 0 / 0.3), 0 16px 32px -8px rgb(0 0 0 / 0.35)",
          "text-shadow-subtle": "0.5px 1px 0.5px rgb(0 0 0 / 0.08)",
          "color-field": "var(--field)",
          "color-raised": "var(--raised)",
          "color-raised-hover": "var(--raised-hover)"
        }
      },
      "css": {
        "@layer base": {
          ":root": {
            "--layer-name": "page",
            "--layer": "var(--color-surface-2)",
            "--field": "var(--color-surface-1)",
            "--raised": "var(--color-surface-4)",
            "--raised-hover": "var(--color-surface-5)"
          },
          "body": {
            "font-family": "var(--font-sans)",
            "font-size": "13px",
            "line-height": "20px",
            "color": "var(--color-foreground)",
            "background": "var(--layer)",
            "color-scheme": "dark",
            "text-shadow": "0.5px 1px 0.5px rgb(20 20 20 / 0.2)"
          },
          "button, input, textarea": {
            "text-shadow": "inherit"
          },
          "label:has(input:is([type=\"checkbox\"], [type=\"radio\"]):enabled)": {
            "cursor": "pointer"
          }
        },
        "@utility layer-card": {
          "--layer-name": "card",
          "--layer": "var(--color-surface-3)",
          "--field": "var(--color-surface-2)",
          "--raised": "var(--color-surface-5)",
          "--raised-hover": "var(--color-surface-6)",
          "background-color": "var(--layer)"
        },
        "@utility layer-elevated": {
          "--layer-name": "elevated",
          "--layer": "var(--color-surface-4)",
          "--field": "var(--color-surface-3)",
          "--raised": "var(--color-surface-6)",
          "--raised-hover": "var(--color-surface-7)",
          "background-color": "var(--layer)"
        },
        "@utility layer-top": {
          "--layer-name": "top",
          "--layer": "var(--color-surface-5)",
          "--field": "var(--color-surface-4)",
          "--raised": "var(--color-surface-7)",
          "--raised-hover": "var(--color-surface-8)",
          "background-color": "var(--layer)"
        },
        "@utility surface-raised": {
          "@apply bg-raised shadow-raised": {}
        },
        "@utility surface-primary": {
          "@apply bg-primary shadow-raised": {}
        },
        "@utility surface-sunken": {
          "@apply bg-field shadow-sunken": {}
        },
        "@utility surface-fill": {
          "@apply bg-primary shadow-sunken": {}
        },
        "@utility drop-shadow-float": {
          "filter": "drop-shadow(0 0 1px rgb(0 0 0 / 0.5)) drop-shadow(0 2px 3px rgb(0 0 0 / 0.2)) drop-shadow(0 8px 12px rgb(0 0 0 / 0.3))"
        },
        "@utility focus-ring": {
          "outline": "2px solid transparent",
          "outline-offset": "1px",
          "&:focus-visible, &:has(:focus-visible)": {
            "outline-color": "var(--color-focus)",
            "transition-duration": "300ms"
          }
        },
        "@utility dim-disabled": {
          "&:is(:disabled, [data-disabled], :has(:disabled))": {
            "pointer-events": "none",
            "opacity": "40%"
          }
        },
        "@utility range-thumb": {
          "@apply appearance-none bg-transparent outline-none [-webkit-tap-highlight-color:transparent] thumb:size-3.5 thumb:appearance-none thumb:rounded-full thumb:border-0 thumb:surface-primary thumb:ring-1 thumb:ring-line thumb:transition focus-visible:thumb:ring-2 focus-visible:thumb:ring-focus": {}
        },
        "@utility shimmer": {
          "mask-image": "linear-gradient(100deg, rgb(0 0 0 / 0.45) 30%, rgb(0 0 0 / 0.6) 40%, #000 50%, rgb(0 0 0 / 0.6) 60%, rgb(0 0 0 / 0.45) 70%)",
          "mask-size": "300% 100%",
          "animation": "shimmer 2.4s ease-in-out infinite",
          "@media (prefers-reduced-motion: reduce)": {
            "mask-image": "none",
            "animation": "none"
          }
        },
        "@keyframes shimmer": {
          "from": {
            "mask-position": "100% 0"
          },
          "75%, to": {
            "mask-position": "0 0"
          }
        },
        "@custom-variant thumb": {
          "&::-webkit-slider-thumb": {
            "@slot": {}
          },
          "&::-moz-range-thumb": {
            "@slot": {}
          }
        }
      }
    },
