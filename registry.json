{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "roprgm",
  "homepage": "https://ui.roprgm.com",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "cssVars": {
        "theme": {
          "font-sans": "\"Geist Variable\", \"Geist\", system-ui, sans-serif",
          "color-level-0": "oklch(0% 0 0)",
          "color-level-1": "oklch(15% 0 0)",
          "color-level-2": "oklch(18.7% 0 0)",
          "color-level-3": "oklch(22.4% 0 0)",
          "color-level-4": "oklch(26.1% 0 0)",
          "color-level-5": "oklch(29.8% 0 0)",
          "color-level-6": "oklch(33.5% 0 0)",
          "color-level-7": "oklch(37.2% 0 0)",
          "color-level-8": "oklch(40.9% 0 0)",
          "color-level-9": "oklch(44.6% 0 0)",
          "color-level-10": "oklch(48.3% 0 0)",
          "color-level-11": "oklch(52% 0 0)",
          "color-level-12": "oklch(55.7% 0 0)",
          "color-background": "var(--color-level-2)",
          "color-hover": "var(--color-level-3)",
          "color-card": "var(--color-level-4)",
          "color-panel": "var(--color-level-4)",
          "color-float": "var(--color-level-4)",
          "color-control": "var(--color-level-5)",
          "color-control-hover": "var(--color-level-6)",
          "color-field": "var(--color-level-0)",
          "color-foreground": "oklch(96% 0 0)",
          "color-secondary": "oklch(70% 0 0)",
          "color-muted": "oklch(55% 0 0)",
          "color-disabled": "oklch(44% 0 0)",
          "color-border": "oklch(0% 0 0 / 0.7)",
          "color-border-subtle": "oklch(0% 0 0 / 0.5)",
          "color-accent": "oklch(89% 0 0)",
          "color-on-accent": "oklch(18% 0 0)",
          "color-accent-text": "var(--color-accent)",
          "color-primary": "var(--color-accent)",
          "color-primary-hover": "oklch(98.5% 0 0)",
          "color-on-primary": "var(--color-on-accent)",
          "color-success": "oklch(78% 0.15 150)",
          "color-warning": "oklch(84% 0.15 85)",
          "color-danger": "oklch(75% 0.14 21)",
          "color-pressed": "oklch(100% 0 0 / 0.15)",
          "color-focus": "oklch(100% 0 0 / 0.25)",
          "color-backdrop": "oklch(0% 0 0 / 0.5)",
          "color-tooltip": "var(--color-level-1)",
          "color-code-keyword": "oklch(77% 0.1 9)",
          "color-code-string": "oklch(81% 0.08 133)",
          "color-code-type": "oklch(81% 0.07 230)",
          "color-code-property": "oklch(83% 0.08 76)",
          "radius-xs": "2.5px",
          "radius-sm": "5px",
          "radius-md": "7px",
          "radius-lg": "9px",
          "radius-xl": "12px",
          "spacing-control-sm": "24px",
          "spacing-control": "28px",
          "spacing-control-lg": "32px",
          "spacing-thumb": "13px",
          "font-weight-selected": "400",
          "shadow-card": "0 1px 1px oklch(0% 0 0 / 0.28), 0 0 1px oklch(0% 0 0 / 0.14)",
          "inset-shadow-card": "inset 0 1px 0 oklch(95% 0 0 / 0.08)",
          "shadow-float": "0 0 0px 1px oklch(10% 0 0 / 0.25), inset 0 1px 0 oklch(100% 0 0 / 0.08), 0 2px 6px oklch(0% 0 0 / 0.3), 0 4px 16px 0 oklch(10% 0 0 / 0.1)",
          "shadow-control": "inset 0 1px 0 oklch(95% 0 0 / 0.08), 0 1px 1px oklch(0% 0 0 / 0.28), 0 0 1px oklch(0% 0 0 / 0.14)",
          "shadow-field": "inset 0 1px 1px oklch(0% 0 0 / 0.3), 0 1px 0 oklch(95% 0 0 / 0.08)",
          "shadow-prominent": "0 0 2px 1px oklch(10% 0 0 / 0.3), inset 0 1px 0 oklch(95% 0 0 / 0.2), 0 1px 2px oklch(10% 0 0 / 0.5)"
        }
      },
      "css": {
        "@utility overflow-fade-y": {
          "overflow-y": "auto",
          "& :focus-visible": {
            "outline-offset": "-2px"
          },
          "mask-image": "linear-gradient(to bottom, transparent, oklch(0% 0 0) var(--overflow-fade-start), oklch(0% 0 0) calc(100% - var(--overflow-fade-end)), transparent)",
          "@supports (animation-timeline: scroll())": {
            "animation": "overflow-fade-start linear both, overflow-fade-end linear both",
            "animation-timeline": "scroll(self block), scroll(self block)",
            "animation-range": "0 1.5rem, calc(100% - 1.5rem) 100%"
          },
          "@supports not (animation-timeline: scroll())": {
            "--overflow-fade-start": "min(1.5rem, var(--scroll-area-overflow-y-start, 0px))",
            "--overflow-fade-end": "min(1.5rem, var(--scroll-area-overflow-y-end, 0px))"
          }
        },
        "@property --overflow-fade-start": {
          "syntax": "\"<length>\"",
          "inherits": "false",
          "initial-value": "0px"
        },
        "@property --overflow-fade-end": {
          "syntax": "\"<length>\"",
          "inherits": "false",
          "initial-value": "0px"
        },
        "@utility overflow-fade-x": {
          "min-width": "0",
          "overflow-x": "auto",
          "overscroll-behavior-x": "contain",
          "scrollbar-width": "none",
          "&::-webkit-scrollbar": {
            "display": "none"
          },
          "& :focus-visible": {
            "outline-offset": "-2px"
          },
          "mask-image": "linear-gradient(to right, transparent, oklch(0% 0 0) var(--overflow-fade-start), oklch(0% 0 0) calc(100% - var(--overflow-fade-end)), transparent)",
          "@supports (animation-timeline: scroll())": {
            "animation": "overflow-fade-start linear both, overflow-fade-end linear both",
            "animation-timeline": "scroll(self inline), scroll(self inline)",
            "animation-range": "0 1.5rem, calc(100% - 1.5rem) 100%"
          }
        },
        "@keyframes overflow-fade-start": {
          "from": {
            "--overflow-fade-start": "0px"
          },
          "to": {
            "--overflow-fade-start": "1.5rem"
          }
        },
        "@keyframes overflow-fade-end": {
          "from": {
            "--overflow-fade-end": "1.5rem"
          },
          "to": {
            "--overflow-fade-end": "0px"
          }
        },
        "@utility shimmer": {
          "mask-image": "linear-gradient(100deg, oklch(0% 0 0 / 0.45) 30%, oklch(0% 0 0 / 0.6) 40%, oklch(0% 0 0) 50%, oklch(0% 0 0 / 0.6) 60%, oklch(0% 0 0 / 0.45) 70%)",
          "mask-size": "300% 100%",
          "animation": "shimmer 2.4s ease-in-out infinite",
          "@media (prefers-reduced-motion: reduce)": {
            "mask-image": "none",
            "animation": "none"
          }
        },
        "@keyframes shimmer": {
          "from": {
            "mask-position": "100% 0"
          },
          "75%, to": {
            "mask-position": "0 0"
          }
        },
        "@layer components": {
          ".material-card": {
            "--color-background": "var(--color-card)",
            "position": "relative",
            "box-shadow": "var(--shadow-card)"
          },
          ".material-panel": {
            "--color-background": "var(--color-panel)"
          },
          ".material-float": {
            "--color-background": "var(--color-float)",
            "box-shadow": "var(--shadow-float)"
          },
          ".material-card, .material-panel, .material-float": {
            "background-color": "var(--color-background)",
            "color": "var(--color-foreground)",
            "--color-control": "var(--color-level-7)",
            "--color-control-hover": "var(--color-level-8)",
            "--color-field": "var(--color-level-2)",
            "--color-hover": "var(--color-level-5)"
          },
          ".material-card::after": {
            "content": "\"\"",
            "position": "absolute",
            "inset": "0",
            "border-radius": "inherit",
            "box-shadow": "var(--inset-shadow-card)",
            "pointer-events": "none"
          },
          ":where(.material-card) :is(.material-card, .material-panel, .material-float), .material-float[data-raised]": {
            "--color-background": "var(--color-level-6)",
            "--color-control": "var(--color-level-9)",
            "--color-control-hover": "var(--color-level-10)",
            "--color-field": "var(--color-level-4)",
            "--color-hover": "var(--color-level-7)"
          },
          "[data-slot=\"button\"][data-variant=\"primary\"]": {
            "text-shadow": "0.5px 1px 0.5px oklch(0% 0 0 / 0.08)"
          },
          "[data-slot=\"separator\"]": {
            "box-shadow": "0 1px 0 oklch(95.5% 0 0 / 0.05)"
          },
          "[data-slot=\"separator\"][data-orientation=\"vertical\"]": {
            "box-shadow": "1px 0 0 oklch(95.5% 0 0 / 0.05)"
          },
          "[data-slot=\"tab-list\"][data-variant=\"underline\"]::before": {
            "box-shadow": "0 1px 0 oklch(95.5% 0 0 / 0.05)"
          }
        },
        "@utility material-control": {
          "background-color": "var(--color-control)",
          "box-shadow": "var(--shadow-control)"
        },
        "@utility material-field": {
          "background-color": "var(--color-field)",
          "box-shadow": "var(--shadow-field)"
        },
        "@utility material-prominent": {
          "background-color": "var(--color-accent)",
          "box-shadow": "var(--shadow-prominent)"
        },
        "@utility segmented": {
          "@apply -my-px gap-0.5 rounded-lg p-0.75": {},
          "& > *": {
            "border-radius": "calc(var(--radius-lg) - 3px)"
          }
        },
        "@utility draw": {
          "stroke-dasharray": "1 2",
          "stroke-dashoffset": "1"
        },
        "@utility drawn": {
          "stroke-dashoffset": "0"
        },
        "@utility popup-motion": {
          "transform-origin": "var(--transform-origin)",
          "transition-property": "opacity, scale",
          "transition-timing-function": "var(--default-transition-timing-function)",
          "transition-duration": "100ms",
          "&[data-starting-style]": {
            "opacity": "0",
            "scale": "0.95"
          },
          "&[data-ending-style]": {
            "opacity": "0"
          }
        },
        "@utility focus-ring": {
          "outline": "2px solid transparent",
          "outline-offset": "1px",
          "&:focus-visible, &:has(:focus-visible)": {
            "outline-color": "var(--color-focus)",
            "transition-duration": "300ms"
          }
        },
        "@utility dim-disabled": {
          "&:is(:disabled, [data-disabled], :has(:disabled))": {
            "pointer-events": "none",
            "opacity": "40%"
          }
        },
        "@layer base": {
          "[data-accent]": {
            "--color-accent-text": "var(--color-accent)",
            "--color-primary": "var(--color-accent)",
            "--color-on-primary": "var(--color-on-accent)"
          },
          "[data-accent=\"violet\"]": {
            "--color-accent": "oklch(62% 0.2 293)",
            "--color-on-accent": "oklch(98.5% 0 0)",
            "--color-primary-hover": "oklch(68% 0.19 293)"
          },
          "[data-accent=\"blue\"]": {
            "--color-accent": "oklch(62% 0.19 255)",
            "--color-on-accent": "oklch(98.5% 0 0)",
            "--color-primary-hover": "oklch(68% 0.17 255)"
          },
          "[data-accent=\"green\"]": {
            "--color-accent": "oklch(72% 0.17 150)",
            "--color-on-accent": "oklch(20% 0.04 150)",
            "--color-primary-hover": "oklch(78% 0.16 150)"
          },
          "[data-accent=\"amber\"]": {
            "--color-accent": "oklch(81% 0.16 80)",
            "--color-on-accent": "oklch(22% 0.04 80)",
            "--color-primary-hover": "oklch(86% 0.14 80)"
          },
          "[data-accent=\"orange\"]": {
            "--color-accent": "oklch(73% 0.17 55)",
            "--color-on-accent": "oklch(20% 0.04 55)",
            "--color-primary-hover": "oklch(79% 0.15 55)"
          },
          "[data-accent=\"coral\"]": {
            "--color-accent": "oklch(71% 0.15 30)",
            "--color-on-accent": "oklch(20% 0.04 30)",
            "--color-primary-hover": "oklch(77% 0.13 30)"
          },
          "[data-accent=\"rose\"]": {
            "--color-accent": "oklch(63% 0.21 10)",
            "--color-on-accent": "oklch(98.5% 0 0)",
            "--color-primary-hover": "oklch(69% 0.19 10)"
          },
          "body": {
            "font-family": "var(--font-sans)",
            "font-size": "13px",
            "line-height": "20px",
            "color": "var(--color-foreground)",
            "background": "var(--color-background)",
            "color-scheme": "dark",
            "text-shadow": "0.5px 1px 0.5px oklch(19.1% 0 0 / 0.2)"
          },
          "button, input, textarea": {
            "text-shadow": "inherit"
          },
          "label:has(input:is([type=\"checkbox\"], [type=\"radio\"]):enabled)": {
            "cursor": "pointer"
          }
        }
      }
    },
