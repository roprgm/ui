{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "roprgm",
  "homepage": "https://ui.roprgm.com",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "cssVars": {
        "theme": {
          "shadow-raised": "inset 0 1px 0 rgb(240 240 240 / 0.06), 0 1px 1px rgb(0 0 0 / 0.25)",
          "shadow-sunken": "inset 0 1px 1px rgb(0 0 0 / 0.3), 0 1px 0 rgb(240 240 240 / 0.04)",
          "shadow-float": "0 0 0 1px var(--color-neutral-900), inset 0 1px 0 rgb(255 255 255 / 0.08), 0 2px 6px rgb(0 0 0 / 0.3), 0 16px 32px -8px rgb(0 0 0 / 0.35)",
          "text-shadow-subtle": "0.5px 1px 0.5px rgb(0 0 0 / 0.08)"
        }
      },
      "css": {
        "@utility drop-shadow-float": {
          "filter": "drop-shadow(0 0 1px rgb(0 0 0 / 0.5)) drop-shadow(0 2px 3px rgb(0 0 0 / 0.2)) drop-shadow(0 8px 12px rgb(0 0 0 / 0.3))"
        },
        "@utility focus-ring": {
          "outline": "2px solid transparent",
          "outline-offset": "1px",
          "&:focus-visible, &:has(:focus-visible)": {
            "outline-color": "rgb(255 255 255 / 0.25)",
            "transition-duration": "300ms"
          }
        },
        "@utility shimmer": {
          "mask-image": "linear-gradient(90deg, rgb(0 0 0 / 0.45) 40%, #000 50%, rgb(0 0 0 / 0.45) 60%)",
          "mask-size": "300% 100%",
          "animation": "shimmer 2s linear infinite",
          "@media (prefers-reduced-motion: reduce)": {
            "mask-image": "none",
            "animation": "none"
          }
        },
        "@keyframes shimmer": {
          "from": { "mask-position": "100% 0" },
          "to": { "mask-position": "0 0" }
        },
        "@custom-variant thumb": {
          "&::-webkit-slider-thumb": { "@slot": {} },
          "&::-moz-range-thumb": { "@slot": {} }
        },
        "@layer base": {
          "body": { "text-shadow": "0.5px 1px 0.5px rgb(0 0 0 / 0.2)" },
          "button, input, textarea": { "text-shadow": "inherit" },
          "label:has(input:is([type=\"checkbox\"], [type=\"radio\"]):enabled)": {
            "cursor": "pointer"
          }
        }
      }
    },
    {
      "name": "base",
      "type": "registry:theme",
      "cssVars": {
        "theme": {
          "font-sans": "\"Geist Variable\", \"Geist\", system-ui, sans-serif",
          "color-page": "color-mix(in oklab, var(--color-neutral-800) 50%, var(--color-neutral-900))"
        }
      },
      "css": {
        "@layer base": {
          "body": {
            "font-family": "var(--font-sans)",
            "font-size": "13px",
            "line-height": "20px",
            "color": "var(--color-neutral-100)",
            "background": "var(--color-page)",
            "color-scheme": "dark"
          }
        }
      }
    },
