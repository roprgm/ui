{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "roprgm",
  "homepage": "https://ui.roprgm.com",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "cssVars": {
        "theme": {
          "font-sans": "\"Geist Variable\", \"Geist\", system-ui, sans-serif",
          "color-level-1": "hsl(0 0% 4%)",
          "color-level-2": "hsl(0 0% 8%)",
          "color-level-3": "hsl(0 0% 12.3%)",
          "color-level-4": "hsl(0 0% 17%)",
          "color-level-5": "hsl(0 0% 22%)",
          "color-level-6": "hsl(0 0% 27.3%)",
          "color-level-7": "hsl(0 0% 33%)",
          "color-level-8": "hsl(0 0% 39%)",
          "color-foreground": "hsl(0 0% 95%)",
          "color-muted": "hsl(0 0% 63%)",
          "color-faint": "hsl(0 0% 45%)",
          "color-disabled": "hsl(0 0% 32%)",
          "color-primary": "hsl(0 0% 86%)",
          "color-primary-hover": "hsl(0 0% 98%)",
          "color-on-primary": "hsl(0 0% 9%)",
          "color-hover": "hsl(0 0% 100% / 0.08)",
          "color-pressed": "hsl(0 0% 100% / 0.15)",
          "color-line": "hsl(0 0% 0% / 0.4)",
          "color-focus": "hsl(0 0% 100% / 0.25)",
          "color-backdrop": "hsl(0 0% 0% / 0.5)",
          "color-danger": "hsl(0 90% 75%)",
          "color-tooltip": "var(--color-level-1)",
          "radius-xs": "2.5px",
          "radius-sm": "5px",
          "radius-md": "7px",
          "radius-lg": "9px",
          "radius-xl": "12px",
          "size-control": "28px",
          "size-control-lg": "calc(var(--size-control) + 4px)",
          "size-control-sm": "calc(var(--size-control) - 4px)",
          "size-item": "calc(var(--size-control) - 2px)",
          "size-row": "calc(var(--size-control) + 12px)",
          "size-thumb": "13px",
          "text-shadow-default": "0.5px 1px 0.5px hsl(0 0% 7.84% / 0.2)",
          "text-shadow-subtle": "0.5px 1px 0.5px hsl(0 0% 0% / 0.08)",
          "color-field": "var(--field)",
          "color-raised": "var(--raised)",
          "color-raised-hover": "var(--raised-hover)",
          "spacing-control": "var(--size-control)",
          "spacing-control-sm": "var(--size-control-sm)",
          "spacing-control-lg": "var(--size-control-lg)",
          "spacing-item": "var(--size-item)",
          "spacing-row": "var(--size-row)",
          "spacing-thumb": "var(--size-thumb)"
        }
      },
      "css": {
        "@layer base": {
          ":root": {
            "--layer": "var(--color-level-2)",
            "--field": "var(--color-level-1)",
            "--raised": "var(--color-level-4)",
            "--raised-hover": "var(--color-level-5)"
          },
          "body": {
            "font-family": "var(--font-sans)",
            "font-size": "13px",
            "line-height": "20px",
            "color": "var(--color-foreground)",
            "background": "var(--layer)",
            "color-scheme": "dark",
            "text-shadow": "var(--text-shadow-default)"
          },
          "button, input, textarea": {
            "text-shadow": "inherit"
          },
          "label:has(input:is([type=\"checkbox\"], [type=\"radio\"]):enabled)": {
            "cursor": "pointer"
          }
        },
        "@utility surface-card": {
          "--layer": "var(--color-level-3)",
          "--field": "var(--color-level-2)",
          "--raised": "var(--color-level-5)",
          "--raised-hover": "var(--color-level-6)",
          "background-color": "var(--layer)",
          ":where(.surface-card, .surface-panel, .surface-float) &": {
            "--layer": "var(--color-level-4)",
            "--field": "var(--color-level-3)",
            "--raised": "var(--color-level-6)",
            "--raised-hover": "var(--color-level-7)"
          },
          "box-shadow": "inset 0 1px 0 hsl(0 0% 94.12% / 0.07), 0 1px 1px hsl(0 0% 0% / 0.28), 0 0 1px hsl(0 0% 0% / 0.14)"
        },
        "@utility surface-panel": {
          "--layer": "var(--color-level-3)",
          "--field": "var(--color-level-2)",
          "--raised": "var(--color-level-5)",
          "--raised-hover": "var(--color-level-6)",
          "background-color": "var(--layer)"
        },
        "@utility surface-float": {
          "--layer": "var(--color-level-4)",
          "--field": "var(--color-level-3)",
          "--raised": "var(--color-level-6)",
          "--raised-hover": "var(--color-level-7)",
          "background-color": "var(--layer)",
          "box-shadow": "0 0 2px 1px hsl(0 0% 9% / 0.8), inset 0 1px 0 hsl(0 0% 100% / 0.08), 0 2px 6px hsl(0 0% 0% / 0.3), 0 4px 16px 0 hsl(0 0% 4% / 0.1)"
        },
        "@utility surface-callout": {
          "@apply bg-tooltip": {},
          "filter": "drop-shadow(0 0 1px hsl(0 0% 0% / 0.5)) drop-shadow(0 2px 3px hsl(0 0% 0% / 0.2)) drop-shadow(0 8px 12px hsl(0 0% 0% / 0.3))"
        },
        "@utility surface-raised": {
          "@apply bg-raised": {},
          "box-shadow": "inset 0 1px 0 hsl(0 0% 94.12% / 0.07), 0 1px 1px hsl(0 0% 0% / 0.28), 0 0 1px hsl(0 0% 0% / 0.14)"
        },
        "@utility surface-sunken": {
          "@apply bg-field": {},
          "box-shadow": "inset 0 1px 1px hsl(0 0% 0% / 0.3), 0 1px 0 hsl(0 0% 94.12% / 0.05)"
        },
        "@utility surface-thumb": {
          "@apply bg-primary": {},
          "box-shadow": "0 0 2px 1px hsl(0 0% 9% / 0.2), inset 0 1px 0 hsl(0 0% 96% / 0.2), 0 1px 2px hsl(0 0% 9% / 0.5)"
        },
        "@utility separator": {
          "@apply bg-line": {},
          "box-shadow": "0 1px 0 hsl(0 0% 94.12% / 0.05)"
        },
        "@utility popup-motion": {
          "transform-origin": "var(--transform-origin)",
          "transition-property": "opacity, scale",
          "transition-timing-function": "var(--default-transition-timing-function)",
          "transition-duration": "100ms",
          "&[data-starting-style]": {
            "opacity": "0",
            "scale": "0.95"
          },
          "&[data-ending-style]": {
            "opacity": "0"
          }
        },
        "@utility focus-ring": {
          "outline": "2px solid transparent",
          "outline-offset": "1px",
          "&:focus-visible, &:has(:focus-visible)": {
            "outline-color": "var(--color-focus)",
            "transition-duration": "300ms"
          }
        },
        "@utility dim-disabled": {
          "&:is(:disabled, [data-disabled], :has(:disabled))": {
            "pointer-events": "none",
            "opacity": "40%"
          }
        },
        "@utility range-thumb": {
          "@apply appearance-none bg-transparent outline-none [-webkit-tap-highlight-color:transparent] thumb:size-thumb thumb:appearance-none thumb:rounded-full thumb:border-0 thumb:surface-thumb thumb:transition focus-visible:thumb:ring-2 focus-visible:thumb:ring-focus": {}
        },
        "@utility overflow-fade-y": {
          "overflow-y": "auto",
          "&::before, &::after": {
            "content": "\"\"",
            "position": "sticky",
            "z-index": "10",
            "display": "block",
            "height": "1.5rem",
            "pointer-events": "none",
            "opacity": "0"
          },
          "&::before": {
            "top": "0",
            "margin-bottom": "-1.5rem",
            "background": "linear-gradient(to bottom, hsl(0 0% 0% / 0.2), 30%, transparent)"
          },
          "&::after": {
            "bottom": "0",
            "margin-top": "-1.5rem",
            "background": "linear-gradient(to top, hsl(0 0% 0% / 0.2), 30%, transparent)"
          },
          "@supports (animation-timeline: scroll())": {
            "&::before": {
              "animation": "overflow-fade-in linear both",
              "animation-timeline": "scroll()",
              "animation-range": "0 1.5rem"
            },
            "&::after": {
              "animation": "overflow-fade-out linear both",
              "animation-timeline": "scroll()",
              "animation-range": "calc(100% - 1.5rem) 100%"
            }
          },
          "@supports not (animation-timeline: scroll())": {
            "&::before, &::after": {
              "transition": "opacity 150ms"
            },
            "&[data-overflow-y-start]::before, &[data-overflow-y-end]::after": {
              "opacity": "1"
            }
          }
        },
        "@keyframes overflow-fade-in": {
          "from": {
            "opacity": "0"
          },
          "to": {
            "opacity": "1"
          }
        },
        "@keyframes overflow-fade-out": {
          "from": {
            "opacity": "1"
          },
          "to": {
            "opacity": "0"
          }
        },
        "@property --overflow-fade-start": {
          "syntax": "\"<length>\"",
          "inherits": "false",
          "initial-value": "0px"
        },
        "@property --overflow-fade-end": {
          "syntax": "\"<length>\"",
          "inherits": "false",
          "initial-value": "0px"
        },
        "@utility overflow-fade-x": {
          "min-width": "0",
          "overflow-x": "auto",
          "overscroll-behavior-x": "contain",
          "scrollbar-width": "none",
          "&::-webkit-scrollbar": {
            "display": "none"
          },
          "mask-image": "linear-gradient(to right, transparent, hsl(0 0% 0%) var(--overflow-fade-start), hsl(0 0% 0%) calc(100% - var(--overflow-fade-end)), transparent)",
          "@supports (animation-timeline: scroll())": {
            "animation": "overflow-fade-x-start linear both, overflow-fade-x-end linear both",
            "animation-timeline": "scroll(self inline), scroll(self inline)",
            "animation-range": "0 1.5rem, calc(100% - 1.5rem) 100%"
          }
        },
        "@keyframes overflow-fade-x-start": {
          "from": {
            "--overflow-fade-start": "0px"
          },
          "to": {
            "--overflow-fade-start": "1.5rem"
          }
        },
        "@keyframes overflow-fade-x-end": {
          "from": {
            "--overflow-fade-end": "1.5rem"
          },
          "to": {
            "--overflow-fade-end": "0px"
          }
        },
        "@utility shimmer": {
          "mask-image": "linear-gradient(100deg, hsl(0 0% 0% / 0.45) 30%, hsl(0 0% 0% / 0.6) 40%, hsl(0 0% 0%) 50%, hsl(0 0% 0% / 0.6) 60%, hsl(0 0% 0% / 0.45) 70%)",
          "mask-size": "300% 100%",
          "animation": "shimmer 2.4s ease-in-out infinite",
          "@media (prefers-reduced-motion: reduce)": {
            "mask-image": "none",
            "animation": "none"
          }
        },
        "@keyframes shimmer": {
          "from": {
            "mask-position": "100% 0"
          },
          "75%, to": {
            "mask-position": "0 0"
          }
        },
        "@custom-variant thumb": {
          "&::-webkit-slider-thumb": {
            "@slot": {}
          },
          "&::-moz-range-thumb": {
            "@slot": {}
          }
        }
      }
    },
