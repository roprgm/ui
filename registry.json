{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "roprgm",
  "homepage": "https://ui.roprgm.com",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "cssVars": {
        "theme": {
          "font-sans": "\"Geist Variable\", \"Geist\", system-ui, sans-serif",
          "color-hover": "hsl(0 0% 100% / 0.08)",
          "color-pressed": "hsl(0 0% 100% / 0.15)",
          "color-foreground": "hsl(0 0% 95%)",
          "color-muted": "hsl(0 0% 63%)",
          "color-faint": "hsl(0 0% 45%)",
          "color-disabled": "hsl(0 0% 32%)",
          "color-primary": "hsl(0 0% 86%)",
          "color-primary-hover": "hsl(0 0% 98%)",
          "color-on-primary": "hsl(0 0% 9%)",
          "color-line": "hsl(0 0% 0% / 0.4)",
          "color-backdrop": "hsl(0 0% 0% / 0.5)",
          "color-focus": "hsl(0 0% 100% / 0.25)",
          "color-danger": "hsl(0 90% 75%)",
          "color-level-1": "hsl(0 0% 4%)",
          "color-level-2": "hsl(0 0% 8%)",
          "color-level-3": "hsl(0 0% 12.3%)",
          "color-level-4": "hsl(0 0% 17%)",
          "color-level-5": "hsl(0 0% 22%)",
          "color-level-6": "hsl(0 0% 27.3%)",
          "color-level-7": "hsl(0 0% 33%)",
          "color-level-8": "hsl(0 0% 39%)",
          "color-tooltip": "var(--color-level-1)",
          "radius-xs": "2.5px",
          "radius-sm": "5px",
          "radius-md": "7px",
          "radius-lg": "9px",
          "radius-xl": "12px",
          "padding": "14px",
          "padding-sm": "5px",
          "padding-xs": "3px",
          "padding-row": "6px",
          "size-control": "28px",
          "size-thumb": "13px",
          "size-control-lg": "calc(var(--size-control) + 4px)",
          "size-control-sm": "calc(var(--size-control) - 4px)",
          "size-row": "calc(var(--size-control) + 2 * var(--padding-row))",
          "padding-optical": "calc(var(--padding) - 2px)",
          "text-shadow-default": "0.5px 1px 0.5px hsl(0 0% 7.84% / 0.2)",
          "text-shadow-subtle": "0.5px 1px 0.5px hsl(0 0% 0% / 0.08)",
          "color-field": "color-mix(in srgb, var(--layer), hsl(0 0% 0%) 35%)",
          "color-raised": "color-mix(in srgb, var(--layer), hsl(0 0% 100%) 11%)",
          "color-raised-hover": "color-mix(in srgb, var(--layer), hsl(0 0% 100%) 17%)"
        }
      },
      "css": {
        "@layer base": {
          ":root": {
            "--layer": "var(--color-level-2)"
          },
          "body": {
            "font-family": "var(--font-sans)",
            "font-size": "13px",
            "line-height": "20px",
            "color": "var(--color-foreground)",
            "background": "var(--layer)",
            "color-scheme": "dark",
            "text-shadow": "var(--text-shadow-default)"
          },
          "button, input, textarea": {
            "text-shadow": "inherit"
          },
          "label:has(input:is([type=\"checkbox\"], [type=\"radio\"]):enabled)": {
            "cursor": "pointer"
          }
        },
        "@utility layer-card": {
          "--layer": "var(--color-level-3)",
          "background-color": "var(--layer)"
        },
        "@utility layer-elevated": {
          "--layer": "var(--color-level-4)",
          "background-color": "var(--layer)"
        },
        "@utility surface-raised": {
          "@apply bg-raised": {},
          "box-shadow": "inset 0 1px 0 hsl(0 0% 94.12% / 0.07), 0 1px 1px hsl(0 0% 0% / 0.28), 0 0 1px hsl(0 0% 0% / 0.14)"
        },
        "@utility surface-sunken": {
          "@apply bg-field": {},
          "box-shadow": "inset 0 1px 1px hsl(0 0% 0% / 0.3), 0 1px 0 hsl(0 0% 94.12% / 0.05)"
        },
        "@utility surface-card": {
          "background-color": "var(--layer)",
          "box-shadow": "inset 0 1px 0 hsl(0 0% 94.12% / 0.07), 0 1px 1px hsl(0 0% 0% / 0.28), 0 0 1px hsl(0 0% 0% / 0.14)"
        },
        "@utility surface-float": {
          "--surface": "float",
          "box-shadow": "0 0 2px 1px hsl(0 0% 9% / 0.8), inset 0 1px 0 hsl(0 0% 100% / 0.08), 0 2px 6px hsl(0 0% 0% / 0.3), 0 4px 16px 0 hsl(0 0% 4% / 0.1)"
        },
        "@utility surface-callout": {
          "@apply bg-tooltip": {},
          "filter": "drop-shadow(0 0 1px hsl(0 0% 0% / 0.5)) drop-shadow(0 2px 3px hsl(0 0% 0% / 0.2)) drop-shadow(0 8px 12px hsl(0 0% 0% / 0.3))"
        },
        "@utility surface-thumb": {
          "@apply bg-primary": {},
          "box-shadow": "0 0 2px 1px hsl(0 0% 9% / 0.2), inset 0 1px 0 hsl(0 0% 96% / 0.2), 0 1px 2px hsl(0 0% 9% / 0.5)"
        },
        "@utility separator": {
          "@apply bg-line": {},
          "box-shadow": "0 1px 0 hsl(0 0% 94.12% / 0.05)"
        },
        "@utility focus-ring": {
          "outline": "2px solid transparent",
          "outline-offset": "1px",
          "&:focus-visible, &:has(:focus-visible)": {
            "outline-color": "var(--color-focus)",
            "transition-duration": "300ms"
          }
        },
        "@utility dim-disabled": {
          "&:is(:disabled, [data-disabled], :has(:disabled))": {
            "pointer-events": "none",
            "opacity": "40%"
          }
        },
        "@utility range-thumb": {
          "@apply appearance-none bg-transparent outline-none [-webkit-tap-highlight-color:transparent] thumb:size-(--size-thumb) thumb:appearance-none thumb:rounded-full thumb:border-0 thumb:surface-thumb thumb:transition focus-visible:thumb:ring-2 focus-visible:thumb:ring-focus": {}
        },
        "@utility shimmer": {
          "mask-image": "linear-gradient(100deg, hsl(0 0% 0% / 0.45) 30%, hsl(0 0% 0% / 0.6) 40%, hsl(0 0% 0%) 50%, hsl(0 0% 0% / 0.6) 60%, hsl(0 0% 0% / 0.45) 70%)",
          "mask-size": "300% 100%",
          "animation": "shimmer 2.4s ease-in-out infinite",
          "@media (prefers-reduced-motion: reduce)": {
            "mask-image": "none",
            "animation": "none"
          }
        },
        "@keyframes shimmer": {
          "from": {
            "mask-position": "100% 0"
          },
          "75%, to": {
            "mask-position": "0 0"
          }
        },
        "@custom-variant thumb": {
          "&::-webkit-slider-thumb": {
            "@slot": {}
          },
          "&::-moz-range-thumb": {
            "@slot": {}
          }
        }
      }
    },
