  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "cssVars": {
        "theme": {
          "font-sans": "var(--font-sans)",
          "default-transition-timing-function": "var(--default-transition-timing-function)",
          "color-level-0": "var(--color-level-0)",
          "color-level-1": "var(--color-level-1)",
          "color-level-2": "var(--color-level-2)",
          "color-level-3": "var(--color-level-3)",
          "color-level-4": "var(--color-level-4)",
          "color-level-5": "var(--color-level-5)",
          "color-level-6": "var(--color-level-6)",
          "color-level-7": "var(--color-level-7)",
          "color-level-8": "var(--color-level-8)",
          "color-level-9": "var(--color-level-9)",
          "color-level-10": "var(--color-level-10)",
          "color-level-11": "var(--color-level-11)",
          "color-level-12": "var(--color-level-12)",
          "color-foreground": "var(--color-foreground)",
          "color-muted": "var(--color-muted)",
          "color-faint": "var(--color-faint)",
          "color-disabled": "var(--color-disabled)",
          "color-primary": "var(--color-primary)",
          "color-primary-hover": "var(--color-primary-hover)",
          "color-on-primary": "var(--color-on-primary)",
          "color-pressed": "var(--color-pressed)",
          "color-focus": "var(--color-focus)",
          "color-backdrop": "var(--color-backdrop)",
          "color-line": "var(--color-line)",
          "color-separator": "var(--color-separator)",
          "color-danger": "var(--color-danger)",
          "color-code-keyword": "var(--color-code-keyword)",
          "color-code-string": "var(--color-code-string)",
          "color-code-type": "var(--color-code-type)",
          "color-code-property": "var(--color-code-property)",
          "color-surface": "var(--color-surface)",
          "color-field": "var(--color-field)",
          "color-raised": "var(--color-raised)",
          "color-raised-hover": "var(--color-raised-hover)",
          "color-hover": "var(--color-hover)",
          "edge-raised": "var(--edge-raised)",
          "edge-sunken": "var(--edge-sunken)",
          "edge-primary": "var(--edge-primary)",
          "edge-card": "var(--edge-card)",
          "edge-float": "var(--edge-float)",
          "color-separator-light": "var(--color-separator-light)",
          "radius-xs": "var(--radius-xs)",
          "radius-sm": "var(--radius-sm)",
          "radius-md": "var(--radius-md)",
          "radius-lg": "var(--radius-lg)",
          "radius-xl": "var(--radius-xl)",
          "spacing-thumb": "var(--spacing-thumb)",
          "text-shadow-default": "var(--text-shadow-default)",
          "text-shadow-subtle": "var(--text-shadow-subtle)"
        }
      },
      "css": {
        "@layer theme": {
          ":root": {
            "--font-sans": "\"Geist Variable\", \"Geist\", system-ui, sans-serif",
            "--default-transition-timing-function": "cubic-bezier(.4, 0, .2, 1)",
            "--color-level-0": "oklch(0% 0 0)",
            "--color-level-1": "oklch(15% 0 0)",
            "--color-level-2": "oklch(18.7% 0 0)",
            "--color-level-3": "oklch(22.4% 0 0)",
            "--color-level-4": "oklch(26.1% 0 0)",
            "--color-level-5": "oklch(29.8% 0 0)",
            "--color-level-6": "oklch(33.5% 0 0)",
            "--color-level-7": "oklch(37.2% 0 0)",
            "--color-level-8": "oklch(40.9% 0 0)",
            "--color-level-9": "oklch(44.6% 0 0)",
            "--color-level-10": "oklch(48.3% 0 0)",
            "--color-level-11": "oklch(52% 0 0)",
            "--color-level-12": "oklch(55.7% 0 0)",
            "--color-foreground": "oklch(96% 0 0)",
            "--color-muted": "oklch(70% 0 0)",
            "--color-faint": "oklch(55% 0 0)",
            "--color-disabled": "oklch(44% 0 0)",
            "--color-primary": "oklch(89% 0 0)",
            "--color-primary-hover": "oklch(98.5% 0 0)",
            "--color-on-primary": "oklch(18% 0 0)",
            "--color-pressed": "oklch(100% 0 0 / .15)",
            "--color-focus": "oklch(100% 0 0 / .25)",
            "--color-backdrop": "oklch(0% 0 0 / .5)",
            "--color-line": "oklch(0% 0 0 / .5)",
            "--color-separator": "oklch(0% 0 0 / .7)",
            "--color-danger": "oklch(75% .14 21)",
            "--color-code-keyword": "oklch(77% .1 9)",
            "--color-code-string": "oklch(81% .08 133)",
            "--color-code-type": "oklch(81% .07 230)",
            "--color-code-property": "oklch(83% .08 76)",
            "--color-surface": "var(--color-level-2)",
            "--color-field": "var(--color-level-0)",
            "--color-raised": "var(--color-level-5)",
            "--color-raised-hover": "var(--color-level-6)",
            "--color-hover": "var(--color-level-3)",
            "--edge-raised": "inset 0 1px 0 oklch(95% 0 0 / .08), 0 1px 1px oklch(0% 0 0 / .28), 0 0 1px oklch(0% 0 0 / .14)",
            "--edge-sunken": "inset 0 1px 1px oklch(0% 0 0 / .3), 0 1px 0 oklch(95% 0 0 / .08)",
            "--edge-primary": "0 0 2px 1px oklch(10% 0 0 / .3), inset 0 1px 0 oklch(95% 0 0 / .2), 0 1px 2px oklch(10% 0 0 / .5)",
            "--edge-card": "inset 0 1px 0 oklch(95% 0 0 / .08), 0 1px 1px oklch(0% 0 0 / .28), 0 0 1px oklch(0% 0 0 / .14)",
            "--edge-float": "0 0 0px 1px oklch(10% 0 0 / .25), inset 0 1px 0 oklch(100% 0 0 / .08), 0 2px 6px oklch(0% 0 0 / .3), 0 4px 16px 0 oklch(10% 0 0 / .1)",
            "--color-separator-light": "oklch(95.5% 0 0 / .05)",
            "--radius-xs": "2.5px",
            "--radius-sm": "5px",
            "--radius-md": "7px",
            "--radius-lg": "9px",
            "--radius-xl": "12px",
            "--spacing-thumb": "13px",
            "--text-shadow-default": ".5px 1px .5px oklch(19.1% 0 0 / .2)",
            "--text-shadow-subtle": ".5px 1px .5px oklch(0% 0 0 / .08)"
          }
        },
        "@layer components": {
          ".surface-card, .surface-panel, .surface-float": {
            "--color-surface": "var(--color-level-4)",
            "--color-field": "var(--color-level-2)",
            "--color-raised": "var(--color-level-7)",
            "--color-raised-hover": "var(--color-level-8)",
            "--color-hover": "var(--color-level-5)",
            "background-color": "var(--color-surface)"
          },
          ":where(.surface-card, .surface-panel, .surface-float) :is(.surface-card, .surface-panel, .surface-float), .surface-float[data-raised]": {
            "--color-surface": "var(--color-level-6)",
            "--color-field": "var(--color-level-4)",
            "--color-raised": "var(--color-level-9)",
            "--color-raised-hover": "var(--color-level-10)",
            "--color-hover": "var(--color-level-7)"
          },
          ":where(.surface-card, .surface-panel, .surface-float) :where(.surface-card, .surface-panel, .surface-float) :is(.surface-card, .surface-panel, .surface-float)": {
            "--color-surface": "var(--color-level-8)",
            "--color-field": "var(--color-level-6)",
            "--color-raised": "var(--color-level-11)",
            "--color-raised-hover": "var(--color-level-12)",
            "--color-hover": "var(--color-level-9)"
          },
          ".surface-card": {
            "box-shadow": "var(--edge-card)"
          },
          ".surface-float": {
            "box-shadow": "var(--edge-float)"
          },
          ".sections, .sections-stacked": {
            "@apply flex flex-col gap-3 px-3.5 py-2.5": {}
          },
          ".sections:has(> [data-slot=\"section\"]), .sections-stacked:has(> [data-slot=\"section\"])": {
            "@apply gap-0 p-0": {}
          },
          ".overflow-fade-y": {
            "overflow-y": "auto"
          },
          ".overflow-fade-y:before, .overflow-fade-y:after": {
            "content": "\"\"",
            "z-index": "10",
            "pointer-events": "none",
            "opacity": "0",
            "height": "1.5rem",
            "display": "block",
            "position": "sticky"
          },
          ".overflow-fade-y:before": {
            "background": "linear-gradient(oklch(0% 0 0 / .2), 30%, #0000)",
            "margin-bottom": "-1.5rem",
            "top": "0"
          },
          ".overflow-fade-y:after": {
            "background": "linear-gradient(to top, oklch(0% 0 0 / .2), 30%, #0000)",
            "margin-top": "-1.5rem",
            "bottom": "0"
          },
          "@supports (animation-timeline: scroll())": {
            ".overflow-fade-y:before": {
              "animation": "linear both overflow-fade-in scroll()",
              "animation-range": "0 1.5rem"
            },
            ".overflow-fade-y:after": {
              "animation": "linear both overflow-fade-out scroll()",
              "animation-range": "calc(100% - 1.5rem) 100%"
            },
            ".overflow-fade-x": {
              "animation": "linear both overflow-fade-x-start scroll(self inline), linear both overflow-fade-x-end scroll(self inline)",
              "animation-range": "0 1.5rem, calc(100% - 1.5rem) 100%"
            }
          },
          "@supports not (animation-timeline: scroll())": {
            ".overflow-fade-y:before, .overflow-fade-y:after": {
              "transition": "opacity .15s"
            },
            ".overflow-fade-y[data-overflow-y-start]:before, .overflow-fade-y[data-overflow-y-end]:after": {
              "opacity": "1"
            }
          },
          ".overflow-fade-x": {
            "overscroll-behavior-x": "contain",
            "scrollbar-width": "none",
            "min-width": "0",
            "overflow-x": "auto",
            "mask-image": "linear-gradient(to right, transparent, oklch(0% 0 0) var(--overflow-fade-start), oklch(0% 0 0) calc(100% - var(--overflow-fade-end)), transparent)"
          },
          ".overflow-fade-x::-webkit-scrollbar": {
            "display": "none"
          },
          ".shimmer": {
            "animation": "2.4s ease-in-out infinite shimmer",
            "mask-image": "linear-gradient(100deg, oklch(0% 0 0 / .45) 30%, oklch(0% 0 0 / .6) 40%, oklch(0% 0 0) 50%, oklch(0% 0 0 / .6) 60%, oklch(0% 0 0 / .45) 70%)",
            "mask-size": "300% 100%"
          },
          "@media (prefers-reduced-motion: reduce)": {
            ".shimmer": {
              "animation": "none",
              "mask-image": "none"
            }
          }
        },
        "@utility surface-raised": {
          "background-color": "var(--color-raised)",
          "box-shadow": "var(--edge-raised)"
        },
        "@utility surface-sunken": {
          "background-color": "var(--color-field)",
          "box-shadow": "var(--edge-sunken)"
        },
        "@utility surface-primary": {
          "background-color": "var(--color-primary)",
          "box-shadow": "var(--edge-primary)"
        },
        "@utility segmented": {
          "@apply -my-px gap-0.5 rounded-lg p-0.75": {},
          "& > *": {
            "border-radius": "calc(var(--radius-lg) - 3px)"
          }
        },
        "@utility separator": {
          "@apply bg-separator": {},
          "box-shadow": "0 1px 0 var(--color-separator-light)",
          "&[aria-orientation=\"vertical\"]": {
            "box-shadow": "1px 0 0 var(--color-separator-light)"
          }
        },
        "@layer utilities": {
          ".sections:has(> [data-slot=\"section\"]) > :not(:last-child)": {
            "@apply shadow-[inset_0_-1px_0_var(--color-line)]": {}
          },
          ".sections-stacked > [data-slot=\"section\"]:not(:last-child)": {
            "@apply pb-0": {}
          },
          ".overflow-fade-x :focus-visible": {
            "outline-offset": "-2px"
          }
        },
        "@utility popup": {
          "@apply max-h-(--available-height) min-w-40 overflow-x-hidden overflow-y-auto rounded-xl text-foreground outline-none popup-motion": {}
        },
        "@utility popup-list": {
          "@apply popup": {},
          "@apply flex flex-col gap-0.5 rounded-lg p-1": {}
        },
        "@utility popup-item": {
          "@apply flex h-6.5 shrink-0 cursor-default items-center rounded-sm px-2.5 outline-none select-none data-disabled:text-disabled data-highlighted:bg-raised": {}
        },
        "@utility field": {
          "@apply w-full min-w-0 rounded-md surface-sunken px-2.5 text-foreground transition focus-ring placeholder:text-muted dim-disabled aria-[invalid=true]:ring-1 aria-[invalid=true]:ring-danger/60": {}
        },
        "@utility popup-motion": {
          "transform-origin": "var(--transform-origin)",
          "transition-property": "opacity, scale",
          "transition-timing-function": "var(--default-transition-timing-function)",
          "transition-duration": ".1s",
          "&[data-starting-style]": {
            "opacity": "0",
            "scale": ".95"
          },
          "&[data-ending-style]": {
            "opacity": "0"
          }
        },
        "@utility focus-ring": {
          "outline": "2px solid transparent",
          "outline-offset": "1px",
          "&:focus-visible, &:has(:focus-visible)": {
            "outline-color": "var(--color-focus)",
            "transition-duration": ".3s"
          }
        },
        "@utility dim-disabled": {
          "&:is(:disabled, [data-disabled], :has(:disabled))": {
            "pointer-events": "none",
            "opacity": "40%"
          }
        },
        "@keyframes overflow-fade-in": {
          "from": {
            "opacity": "0"
          },
          "to": {
            "opacity": "1"
          }
        },
        "@keyframes overflow-fade-out": {
          "from": {
            "opacity": "1"
          },
          "to": {
            "opacity": "0"
          }
        },
        "@property --overflow-fade-start": {
          "syntax": "\"<length>\"",
          "inherits": "false",
          "initial-value": "0"
        },
        "@property --overflow-fade-end": {
          "syntax": "\"<length>\"",
          "inherits": "false",
          "initial-value": "0"
        },
        "@keyframes overflow-fade-x-start": {
          "from": {
            "--overflow-fade-start": "0px"
          },
          "to": {
            "--overflow-fade-start": "1.5rem"
          }
        },
        "@keyframes overflow-fade-x-end": {
          "from": {
            "--overflow-fade-end": "1.5rem"
          },
          "to": {
            "--overflow-fade-end": "0px"
          }
        },
        "@utility draw": {
          "stroke-dasharray": "1 2",
          "stroke-dashoffset": "1"
        },
        "@utility drawn": {
          "stroke-dashoffset": "0"
        },
        "@keyframes shimmer": {
          "from": {
            "mask-position": "100% 0"
          },
          "75%, to": {
            "mask-position": "0 0"
          }
        },
        "@layer base": {
          "body": {
            "font-family": "var(--font-sans)",
            "color": "var(--color-foreground)",
            "background": "var(--color-surface)",
            "color-scheme": "dark",
            "text-shadow": "var(--text-shadow-default)",
            "font-size": "13px",
            "line-height": "20px"
          },
          "button, input, textarea": {
            "text-shadow": "inherit"
          },
          "label:has(input:is([type=\"checkbox\"], [type=\"radio\"]):enabled)": {
            "cursor": "pointer"
          }
        }
      }
    },
